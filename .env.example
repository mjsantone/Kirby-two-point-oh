# Copy to .env (or export in your shell) before starting the server
ANTHROPIC_API_KEY=

# Required only for the "Image" output type (OpenAI image generation)
OPENAI_API_KEY=sk-...

# Optional shared Discover gallery (otherwise saves to ignored local data/)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=fuse-discover

# Optional overrides
# PORT=3000
# FUSE_MODEL=claude-fable-5
# IMAGE_MODEL=gpt-image-2
# OPENAI_BASE_URL=https://api.openai.com
