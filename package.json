{
  "name": "fuse-metaball-canvas",
  "version": "0.1.0",
  "description": "Drop up to 5 ingredients (text or images) onto a gooey metaball canvas, size them for influence, and fuse them into an interactive HTML artifact with Claude.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@azure/storage-blob": "12.27.0",
    "express": "^4.21.2",
    "pureimage": "^0.4.20",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  },
  "overrides": {
    "@azure/abort-controller": "2.1.2",
    "@azure/core-auth": "1.9.0",
    "@azure/core-client": "1.9.3",
    "@azure/core-http-compat": "2.2.0",
    "@azure/core-lro": "2.7.2",
    "@azure/core-paging": "1.6.2",
    "@azure/core-rest-pipeline": "1.19.1",
    "@azure/core-tracing": "1.2.0",
    "@azure/core-util": "1.11.0",
    "@azure/core-xml": "1.4.5",
    "@azure/logger": "1.1.4"
  }
}
